# Supabase Configuration (existing — required for all admin-app features)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# Server Port (existing)
PORT=5000

# AI Content Creation Assistant ("Content Buddy AI") — see specs/001-ai-content-assistant/
# Claude is the only external AI service this backend calls (no OpenAI / second vendor —
# speech-to-text is handled on-device in the mobile app, not here).
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-5
